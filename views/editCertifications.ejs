        /* Edit Form Container */
        #edit-form-container {
            margin-top: 30px;
        }

        #edit-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        #edit-form input, #edit-form textarea {
            padding: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        #edit-form button {
            padding: 10px 20px;
