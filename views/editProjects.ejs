<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/public/favicon.png">
    <title>Edit Project</title>
    <style>
       body {
            font-family: "Nova Mono", monospace;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
            color: #333;
        }

        /* Login Section Styles */
        #login-container {
            max-width: 400px;
            margin: 100px auto;
            background: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            border-radius: 10px;
            padding: 30px;
            text-align: center;
        }

        #login-container h1 {
            font-size: 24px;
            margin-bottom: 20px;
            color: #444;
        }

        #login-container input {
            width: 90%;
            padding: 10px;
            font-size: 16px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        #login-container button {
            padding: 10px 20px;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            background-color: #28a745;
            color: white;
            cursor: pointer;
        }

        #login-container button:hover {
            background-color: #218838;
        }

        #login-container p {
            margin-top: 10px;
            font-size: 14px;
            color: #666;
        }

        /* Edit Section Styles */
        #edit-container {
            display: none; /* Hidden by default */
            max-width: 900px;
            margin: 40px auto;
            background: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            padding: 20px;
        }

        h1, h2 {
            text-align: center;
            color: #444;
        }

        #Project-list {
            margin: 20px 0;
        }

        .project {
            background: #fafafa;
            padding: 15px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        .project p {
            margin: 0;
            line-height: 1.5;
        }

        .project button {
            margin-top: 10px;
            margin-right: 5px;
            padding: 8px 12px;
            border: none;
            border-radius: 4px;
            background-color: #007BFF;
            color: white;
            cursor: pointer;
        }

        .project button:hover {
            background-color: #0056b3;
        } 
        
