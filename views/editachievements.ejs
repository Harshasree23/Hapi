<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Achievements</title>
    <%- include('./partials/style') %>
</head>
<body>
    <div id="edit-container">
        <h1>Edit Achievements</h1>
        <div id="achievements-list"></div>
        <div id="edit-form-container" style="display: none;">
            <h2>Edit Achievement</h2>
            <form id="edit-form">
                <input type="hidden" id="achievement-id" />
                <label for="achievement-name">Name:</label>
                <input type="text" id="achievement-name" required />
                <label for="achievement-description">Description:</label>
                <textarea id="achievement-description" required></textarea>
                <label for="achievement-skills">Skills (comma-separated):</label>
                <input type="text" id="achievement-skills" required />
                <button type="button" onclick="submitEditForm()">Save</button>
                <button type="button" onclick="cancelEdit()">Cancel</button>
            </form>
        </div>
    </div>
    <%- include('./partials/sameScript.ejs') %>
    <script>
        // Fetch achievements and display them
        fetch('/api/achievements')
            .then((response) => response.json())
            .then((data) => {
                const list = document.getElementById('achievements-list');
                list.innerHTML = '';
                data.forEach((achievement) => {
                    const achievementDiv = document.createElement('div');
                    achievementDiv.innerHTML = `
                        <div class="achievement">
                            <p><strong>${achievement.achievementName}</strong>: ${achievement.description}</p>
                            <p>Skills: ${achievement.skills.join(', ')}</p>
                            <button onclick="showEditForm('${achievement._id}', '${achievement.achievementName}', '${achievement.description}', '${achievement.skills.join(', ')}')">Edit</button>
                            <button onclick="deleteAchievement('${achievement._id}')">Delete</button>
                        </div>
                    `;
                    list.appendChild(achievementDiv);
                });
            });

        // Show the edit form and populate it with existing data
        function showEditForm(id, name, description, skills) {
            document.getElementById('edit-form-container').style.display = 'block';
            document.getElementById('achievement-id').value = id;
            document.getElementById('achievement-name').value = name;
            document.getElementById('achievement-description').value = description;
            document.getElementById('achievement-skills').value = skills;
        }

        // Submit the edit form
        function submitEditForm() {
            const id = document.getElementById('achievement-id').value;
            const name = document.getElementById('achievement-name').value;
            const description = document.getElementById('achievement-description').value;
            const skills = document.getElementById('achievement-skills').value;

            fetch(`/api/achievements/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, description, skills }),
            })
                .then((response) => response.json())
                .then((data) => {
                    alert(data.message);
                    location.reload();
                })
                .catch((err) => console.error('Error:', err));
        }

        // Cancel editing and hide the form
        function cancelEdit() {
            document.getElementById('edit-form-container').style.display = 'none';
        }

        // Delete an achievement
        function deleteAchievement(id) {
            fetch(`/api/achievements/${id}`, {
                method: 'DELETE',
            })
                .then((response) => response.json())
                .then((data) => {
                    alert(data.message);
                    location.reload();
                })
                .catch((err) => console.error('Error:', err));
        }
    </script>
</body>
</html>
