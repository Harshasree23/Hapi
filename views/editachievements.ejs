<body>

    <!-- Login Section -->
    <div id="login-container">
        <h1>Access Restricted</h1>
        <p>Please enter the password to access this page:</p>
        <input type="password" id="password-input" placeholder="Enter password" required />
        <button onclick="verifyPassword()">Submit</button>
        <p id="error-message" style="color: red; display: none;">Invalid password. Please try again.</p>
    </div>

    <div id="edit-container">
        <h1>Edit Achievements</h1>
        <div id="achievements-list"></div>
        <div id="edit-form-container" style="display: none;">
            <h2>Edit Achievement</h2>
            <form id="edit-form">
                <input type="hidden" id="achievement-id" />
                <label for="achievement-name">Name:</label>
                <input type="text" id="achievement-name" required />
                <label for="achievement-description">Description:</label>
                <textarea id="achievement-description" rows="5" required></textarea>
                <label for="achievement-skills">Skills (comma-separated):</label>
                <input type="text" id="achievement-skills" required />
                <div style="display: flex; justify-content: space-between;">
                    <button type="button" onclick="submitEditForm()">Save</button>
                    <button type="button" style="background-color: red;" onclick="cancelEdit()">Cancel</button>
                </div>
            </form>
        </div>
    </div>
    <script>

         // Check for stored password on page load
         window.onload = function () {
            const storedPassword = sessionStorage.getItem('password');
            if (storedPassword) {
                verifyPassword(storedPassword, true);
            }
        };

        function verifyPassword(enteredPassword = null, isStored = false) {
            const password = enteredPassword || document.getElementById('password-input').value;

            fetch('/api/verify-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password }),
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        // Save password in sessionStorage if not from stored password
                        if (!isStored) {
                            sessionStorage.setItem('password', password);
                        }
                        document.getElementById('login-container').style.display = 'none';
                        document.getElementById('edit-container').style.display = 'block';
                        fetchbadges();
                    } else {
                        document.getElementById('error-message').style.display = 'block';
                    }
                })
                .catch((err) => console.error('Error:', err));
        }


        // Fetch achievements and display them
        fetch('/api/achievements')
            .then((response) => response.json())
            .then((data) => {
                const list = document.getElementById('achievements-list');
                list.innerHTML = '';
                data.forEach((achievement) => {
                    const achievementDiv = document.createElement('div');
                    achievementDiv.innerHTML = `
                        <div class="achievement">
                            <p><strong>${achievement.achievementName}</strong>: ${achievement.description}</p>
                            <p>Skills: ${achievement.skills.join(', ')}</p>
                            <button style="background-color:#007BFF" onclick="showEditForm('${achievement._id}', '${achievement.achievementName}', '${achievement.description}', '${achievement.skills.join(', ')}')">Edit</button>
                            <button style="background-color:#007BFF"  onclick="deleteAchievement('${achievement._id}')">Delete</button>
                        </div>
                    `;
                    list.appendChild(achievementDiv);
                });
            });

        // Show the edit form and populate it with existing data
        function showEditForm(id, name, description, skills) {
            document.getElementById('edit-form-container').style.display = 'block';
            document.getElementById('achievement-id').value = id;
            document.getElementById('achievement-name').value = name;
            document.getElementById('achievement-description').value = description;
            document.getElementById('achievement-skills').value = skills;
        }

        // Submit the edit form
        function submitEditForm() {
            if (confirm("Are you sure you want to save changes?")) {
                const id = document.getElementById('achievement-id').value;
                const name = document.getElementById('achievement-name').value;
                const description = document.getElementById('achievement-description').value;
                const skills = document.getElementById('achievement-skills').value;

                fetch(`/api/achievements/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, description, skills }),
                })
                    .then((response) => response.json())
                    .then((data) => {
                        alert(data.message);
                        location.reload();
                    })
                    .catch((err) => console.error('Error:', err));
            } else {
                alert("Changes were not saved.");
            }
        }

        // Cancel editing and hide the form
        function cancelEdit() {
            document.getElementById('edit-form-container').style.display = 'none';
        }

        // Delete an achievement
        function deleteAchievement(id) {
            if (confirm("Are you sure you want to delete this achievement? This action cannot be undone.")) {
                fetch(`/api/achievements/${id}`, {
                    method: 'DELETE',
                })
                    .then((response) => response.json())
                    .then((data) => {
                        alert(data.message);
                        location.reload();
                    })
                    .catch((err) => console.error('Error:', err));
            } else {
                alert("Deletion was canceled.");
            }
        }
    </script>
</body>
