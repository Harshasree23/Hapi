<body>

    <!-- Login Section -->
    <div id="login-container">
        <h1>Access Restricted</h1>
        <p>Please enter the password to access this page:</p>
        <input type="password" id="password-input" placeholder="Enter password" required />
        <button onclick="verifyPassword()">Submit</button>
        <p id="error-message" style="color: red; display: none;">Invalid password. Please try again.</p>
    </div>

    <div id="edit-container">
        <h1>Edit Project</h1>
        <div id="Project-list"></div>
        <div id="edit-form-container" style="display: none;">
            <h2>Edit project</h2>
            <form id="edit-form">
                <input type="hidden" id="project-id" />
                <label for="project-name">Name:</label>
                <input type="text" id="project-name" required />
                <label for="project-projectDescription">Project Description:</label>
                <textarea id="project-projectDescription" rows="5" required></textarea>
                <label for="project-skills">Used Technologies (comma-separated):</label>
                <input type="text" id="project-skills" required />
                <label for="project-Link">Link:</label>
                <input type="text" id="project-Link" required />
                <label for="project-verify">Git:</label>
                <input type="text" id="project-verify" required />
                <label for="project-video">Video:</label>
                <input type="text" id="project-video" required />
                <label for="project-images">Images:</label>
                <input type="text" id="project-images" required />
                <div style="display: flex; justify-content: space-between;">
                    <button type="button" onclick="submitEditForm()">Save</button>
                    <button type="button" style="background-color: red;" onclick="cancelEdit()">Cancel</button>
                </div>
            </form>
        </div>
    </div>
    <script>

        // Check for stored password on page load
        window.onload = function () {
            const storedPassword = sessionStorage.getItem('password');
            if (storedPassword) {
                verifyPassword(storedPassword, true);
            }
        };

        function verifyPassword(enteredPassword = null, isStored = false) {
            const password = enteredPassword || document.getElementById('password-input').value;

            fetch('/api/verify-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password }),
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        // Save password in sessionStorage if not from stored password
                        if (!isStored) {
                            sessionStorage.setItem('password', password);
                        }
                        document.getElementById('login-container').style.display = 'none';
                        document.getElementById('edit-container').style.display = 'block';
                        fetchProject();
                    } else {
                        document.getElementById('error-message').style.display = 'block';
                    }
                })
                .catch((err) => console.error('Error:', err));
        }


        // Fetch Project and display them
        fetch('/api/Projects')
            .then((response) => response.json())
            .then((data) => {
                const list = document.getElementById('Project-list');
                list.innerHTML = '';
                data.forEach((project) => {
                    const projectDiv = document.createElement('div');
                    projectDiv.innerHTML = `
                        <div class="project">
                            <p style="width:100%"><strong>${project.projectName}</strong>: ${project.description}</p>
                            <p style="width:100%">Used Technologies: ${project.usedTechnologies.join(', ')}</p>
                            <p style="width:100%">Link : ${project.link}</p>
                            <p style="width:100%">Git : ${project.git}</p>
                            <p style="width:100%">Video : ${project.video}</p>
                            <p style="width:100%">Images :${project.images.join(', ')} </p>
                            <button style="background-color:#008000c4" onclick="showEditForm('${project._id}', '${project.projectName}', '${project.description}', '${project.usedTechnologies.join(', ')}' , '${project.link}' , '${project.git}' ,' ${project.video} ', ' ${project.images.join(", ")} ' )">Edit</button>
                            <button style="background-color:#ff0000bd"  onclick="deleteproject('${project._id}')">Delete</button>
                        </div>
                    `;
                    list.appendChild(projectDiv);
                });
            });

        // Show the edit form and populate it with existing data
        function showEditForm(id, name, projectDescription, skills, Link , verify , video , images) {
            document.getElementById('edit-form-container').style.display = 'block';
            document.getElementById('project-id').value = id;
            document.getElementById('project-name').value = name;
            document.getElementById('project-projectDescription').value = projectDescription;
            document.getElementById('project-skills').value = skills;
            document.getElementById('project-Link').value = Link;
            document.getElementById('project-verify').value = verify;
            document.getElementById('project-video').value = video;
            document.getElementById('project-images').value = images;
        }

        // Submit the edit form
        function submitEditForm() {
            if (confirm("Are you sure you want to save changes?")) {
                const id = document.getElementById('project-id').value;
                const name = document.getElementById('project-name').value;
                const projectDescription = document.getElementById('project-projectDescription').value;
                const usedTechnologies = document.getElementById('project-skills').value;
                const Link = document.getElementById('project-Link').value;
                const git = document.getElementById('project-verify').value ;
                const video = document.getElementById('project-video').value;
                const images = document.getElementById('project-images').value;

                fetch(`/api/projects/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, projectDescription,Link, usedTechnologies, git, video , images }),
                })
                    .then((response) => response.json())
                    .then((data) => {
                        alert(data.message);
                        location.reload();
                    })
                    .catch((err) => console.error('Error:', err));
            } else {
                alert("Changes were not saved.");
            }
        }

        // Cancel editing and hide the form
        function cancelEdit() {
            document.getElementById('edit-form-container').style.display = 'none';
        }

        // Delete an project
        function deleteproject(id) {
            if (confirm("Are you sure you want to delete this project? This action cannot be undone.")) {
                fetch(`/api/projects/${id}`, {
                    method: 'DELETE',
                })
                    .then((response) => response.json())
                    .then((data) => {
                        alert(data.message);
                        location.reload();
                    })
                    .catch((err) => console.error('Error:', err));
            } else {
                alert("Deletion was canceled.");
            }
        }
    </script>
</body>
</html>
