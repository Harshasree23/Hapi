<body>

    <!-- Login Section -->
    <div id="login-container">
        <h1>Access Restricted</h1>
        <p>Please enter the password to access this page:</p>
        <input type="password" id="password-input" placeholder="Enter password" required />
        <button onclick="verifyPassword()">Submit</button>
        <p id="error-message" style="color: red; display: none;">Invalid password. Please try again.</p>
    </div>

    <div id="edit-container">
        <h1>Edit Certification</h1>
        <div id="Certification-list"></div>
        <div id="edit-form-container" style="display: none;">
            <h2>Edit certificate</h2>
            <form id="edit-form">
                <input type="hidden" id="certificate-id" />
                <label for="certificate-name">Name:</label>
                <input type="text" id="certificate-name" required />
                <label for="certificate-certificateDescription">certificate Description:</label>
                <textarea id="certificate-certificateDescription" rows="5" required></textarea>
                <label for="certificate-skills">Skills (comma-separated):</label>
                <input type="text" id="certificate-skills" required />
                <label for="certificate-url">Url:</label>
                <input type="text" id="certificate-url" required />
                <label for="certificate-verify">Verify:</label>
                <input type="text" id="certificate-verify" required />
                <label for="certificate-company">Company:</label>
                <input type="text" id="certificate-company" required />
                <div style="display: flex; justify-content: space-between;">
                    <button type="button" onclick="submitEditForm()">Save</button>
                    <button type="button" style="background-color: red;" onclick="cancelEdit()">Cancel</button>
                </div>
            </form>
        </div>
    </div>
    <script>

        // Check for stored password on page load
        window.onload = function () {
            const storedPassword = sessionStorage.getItem('password');
            if (storedPassword) {
                verifyPassword(storedPassword, true);
            }
        };

        function verifyPassword(enteredPassword = null, isStored = false) {
            const password = enteredPassword || document.getElementById('password-input').value;

            fetch('/api/verify-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password }),
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        // Save password in sessionStorage if not from stored password
                        if (!isStored) {
                            sessionStorage.setItem('password', password);
                        }
                        document.getElementById('login-container').style.display = 'none';
                        document.getElementById('edit-container').style.display = 'block';
                        fetchCertification();
                    } else {
                        document.getElementById('error-message').style.display = 'block';
                    }
                })
                .catch((err) => console.error('Error:', err));
        }


        // Fetch Certification and display them
        fetch('/api/certifications')
            .then((response) => response.json())
            .then((data) => {
                const list = document.getElementById('Certification-list');
                list.innerHTML = '';
                data.forEach((certificate) => {
                    const certificateDiv = document.createElement('div');
                    certificateDiv.innerHTML = `
                        <div class="certificate">
                            <p style="width:100%"><strong>${certificate.certificateName}</strong>: ${certificate.description}</p>
                            <p style="width:100%">Skills: ${certificate.skills.join(', ')}</p>
                            <p style="width:100%">URL : ${certificate.url}</p>
                            <p style="width:100%">Verify : ${certificate.verify}</p>
                            <p style="width:100%">Company : ${certificate.company}</p>
                            <button style="background-color:#007BFF" onclick="showEditForm('${certificate._id}', '${certificate.certificateName}', '${certificate.description}', '${certificate.skills.join(', ')}' , '${certificate.url}' , '${certificate.verify}' ,' ${certificate.company} ' )">Edit</button>
                            <button style="background-color:#007BFF"  onclick="deletecertificate('${certificate._id}')">Delete</button>
                        </div>
                    `;
                    list.appendChild(certificateDiv);
                });
            });

        // Show the edit form and populate it with existing data
        function showEditForm(id, name, certificateDescription, skills, url , verify , company) {
            document.getElementById('edit-form-container').style.display = 'block';
            document.getElementById('certificate-id').value = id;
            document.getElementById('certificate-name').value = name;
            document.getElementById('certificate-certificateDescription').value = certificateDescription;
            document.getElementById('certificate-skills').value = skills;
            document.getElementById('certificate-url').value = url;
            document.getElementById('certificate-verify').value = verify;
            document.getElementById('certificate-company').value = company;
        }

        // Submit the edit form
        function submitEditForm() {
            if (confirm("Are you sure you want to save changes?")) {
                const id = document.getElementById('certificate-id').value;
                const name = document.getElementById('certificate-name').value;
                const certificateDescription = document.getElementById('certificate-certificateDescription').value;
                const skills = document.getElementById('certificate-skills').value;
                const url = document.getElementById('certificate-url').value;
                const verify = document.getElementById('certificate-verify').value ;
                const company = document.getElementById('certificate-company').value;

                fetch(`/api/certifications/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, certificateDescription,url, skills,verify,company }),
                })
                    .then((response) => response.json())
                    .then((data) => {
                        alert(data.message);
                        location.reload();
                    })
                    .catch((err) => console.error('Error:', err));
            } else {
                alert("Changes were not saved.");
            }
        }

        // Cancel editing and hide the form
        function cancelEdit() {
            document.getElementById('edit-form-container').style.display = 'none';
        }

        // Delete an certificate
        function deletecertificate(id) {
            if (confirm("Are you sure you want to delete this certificate? This action cannot be undone.")) {
                fetch(`/api/certifications/${id}`, {
                    method: 'DELETE',
                })
                    .then((response) => response.json())
                    .then((data) => {
                        alert(data.message);
                        location.reload();
                    })
                    .catch((err) => console.error('Error:', err));
            } else {
                alert("Deletion was canceled.");
            }
        }
    </script>
</body>
</html>
