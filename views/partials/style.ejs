<link href="https://fonts.googleapis.com/css2?family=Nova+Mono&display=swap" rel="stylesheet">
<link rel="icon" href="/public/favicon.png">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
<link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: "Urbanist", serif;
        color: #B8FFFF;
    }

    body {
        background-color: #010208;
        overflow-x: hidden;
    }

    .hover {
        background-color: rgba(1, 147, 246, 0.15); 
        padding: 1rem;
        border-radius: 0.3rem;
        color: #B8FFFF;
        border: 0.1rem solid #B8FFFF;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

    .hover:hover {
        background-color: #0193f6; /* Brighter Blue */
        transform: scale(1.05);
        box-shadow: 0.4rem 0.4rem 1rem #B8FFFF;
    }

    .goto {
        padding: 3rem;
        margin: 3rem auto;
        width: fit-content;
        background-color: rgba(1, 147, 246, 0.15);
        border-radius: 0.3rem;
        display: grid;
        gap: 2rem;
        color: #B8FFFF;
        border: 0.1rem solid #B8FFFF;
    }

    .goto a {
        text-decoration: none;
        color: #B8FFFF;
        background-color: rgba(1, 147, 246, 0.15);
        font-size: 1.5rem;
        width: fit-content;
        padding: 1rem;
        border-radius: 0.3rem;
        display: flex;
        gap: 1rem;
        justify-content: center;
        align-items: center;
        border: 0.1rem solid #B8FFFF;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

    .goto a:hover {
        background-color: #07f7eb31; /* Translucent Cyan */
        transform: scale(1.1);
        box-shadow: 0.4rem 0.4rem 1rem #B8FFFF;
    }

    .main-heading {
        min-height: 15vh;
        padding: 2rem;
        font-size: 1.5rem;
        display: flex;
        justify-content: space-around;
        align-items: center;
        background-color: rgba(1, 147, 246, 0.15);
        border-bottom: 0.2rem solid #B8FFFF;
        color: #B8FFFF;
        font-family: "Nova Mono", monospace;
        text-shadow: 0.2rem 0.2rem 0.5rem #87ceeb;
        border-radius: 0 0 1rem 1rem;

    }

    form {
        width: fit-content;
        background-color: rgba(1, 147, 246, 0.15);
        display: grid;
        padding: 2rem;
        margin: 2rem auto;
        font-size: 1.2rem;
        border-radius: 0.3rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
        color: #B8FFFF;
        border: 0.1rem solid #B8FFFF;
    }

    input {
        padding: 0.5rem;
        font-size: 1.2rem;
        margin-bottom: 1.5rem;
        border: 0.1rem solid #B8FFFF;
        border-radius: 0.3rem;
        background-color: rgba(1, 147, 246, 0.05);
        color: #B8FFFF;
    }

    label {
        font-size: 1.2rem;
        padding: 0.3rem;
        color: #B8FFFF;
    }

    button {
        padding: 0.7rem;
        border: none;
        border-radius: 0.3rem;
        background-color: #0193f6;
        color: #B8FFFF;
        font-size: 1.2rem;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

    button:hover {
        background-color: #07f7eb;
        transform: translateY(-3px);
    }

    form button {
        margin: 1rem auto;
        width: fit-content;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @media (max-width: 850px) {
        .main-heading {
            flex-wrap: wrap;
            gap: 1rem;
            font-size: 1.5rem;
        }

        form {
            padding: 1.5rem;
        }

        .goto {
            width: 75%;
            padding: 1rem;
        }

        .goto a {
            font-size: 1rem;
        }
    }

    @media (max-width: 576px) {
        .goto {
            width: 90%;
        }
    }
</style>
